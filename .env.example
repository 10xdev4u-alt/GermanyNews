# 🌍 Germany News Digest Bot — Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# ─── Required ────────────────────────────────────────────────────────────

# Get a free API key from: https://worldnewsapi.com
# Free tier: 50 requests/day, no credit card needed
WORLD_NEWS_API_KEY=your_world_news_api_key_here

# Get a free API key from: https://aistudio.google.com/app/apikey
# Free tier: ~1,500 requests/day with Gemini Flash models
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Telegram (Primary Delivery - RECOMMENDED) ──────────────────────────
# Reliable, official, free, no credit card. Far more stable than WhatsApp.

# How to get your Telegram Bot Token:
# 1. Open Telegram, search for @BotFather
# 2. Send /newbot, choose a name and username (must end in 'bot')
# 3. BotFather will reply with your token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# How to get your Chat ID:
# 1. Message your bot (anything) on Telegram
# 2. Visit: https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/getUpdates
# 3. Look for "chat":{"id":123456789} in the response
TELEGRAM_CHAT_ID=your_chat_id_here

# ─── WhatsApp (Fallback - Less Reliable) ────────────────────────────────
# Uses CallMeBot (free but sometimes unreliable)

# Your WhatsApp phone number with country code (e.g., 491701234567 for Germany)
# Do NOT include the leading '+'
WHATSAPP_PHONE=your_phone_number_here

# CallMeBot API key:
# 1. Add +34 644 03 87 31 to your WhatsApp contacts
# 2. Send "I allow callmebot to send me messages" to that contact
# 3. You'll receive your API key via reply message
CALLMEBOT_API_KEY=your_callmebot_apikey_here

# ─── Optional ────────────────────────────────────────────────────────────

# News categories to fetch (comma-separated)
# Default: politics,sports,technology,business
# NEWS_CATEGORIES=politics,sports,technology,business
